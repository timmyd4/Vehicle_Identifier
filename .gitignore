# Files and folders git should never track.

# Dataset images, generated split CSVs, etc. (~291K images, far too big for git)
data/

# Python virtual environment (rebuild it from requirements.txt)
.venv/

# Python bytecode caches, created automatically when code runs
__pycache__/
*.pyc

# Trained model weights and checkpoints (large binary files)
checkpoints/
*.pt
*.pth
*.ckpt
*.safetensors

# Training logs and evaluation output (regenerated by the scripts)
runs/

# Exported model files the Java app loads (car_model.onnx, labels.json, ...).
# Created by training/export_onnx.py; the README explains how to get them.
app/models/

# Maven build output (compiled classes, packaged jar)
app/target/

# IntelliJ IDEA project files
.idea/
*.iml

# OS clutter
Thumbs.db
.DS_Store
