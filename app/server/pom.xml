<?xml version="1.0" encoding="UTF-8"?>
<!--
  SERVER MODULE: the Spring Boot backend.

  Big picture:
    This is the program that actually runs. It will:
      - load the ONNX models from models/ and identify cars (POST /identify, Phase 4)
      - serve the client's compiled UI files to the browser (end of Phase 3)
    Its build produces the ONE runnable jar: `java -jar car-identifier-server.jar`.

  Right now it is a skeleton: a Spring Boot app on Jetty with no endpoints yet.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit config from app/pom.xml, same as the client. -->
    <parent>
        <groupId>io.github.timmyd4</groupId>
        <artifactId>car-identifier-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>car-identifier-server</artifactId>

    <!-- A normal jar. (spring-boot-maven-plugin will later turn it into a runnable "fat jar".) -->
    <packaging>jar</packaging>

    <name>Car Identifier (server)</name>

    <!--
      The Spring Boot BOM, imported HERE instead of in the parent, so its version
      rules apply only to this module. It pins Spring, Jackson, Jetty 12.1, JUnit, ...
      to versions tested together. ${spring-boot.version} is inherited from the parent.

      This module's dependencyManagement is MERGED with the one it inherits from the
      parent, so onnxruntime (managed in the parent) is still available here too.

      Why not inherit spring-boot-starter-parent instead, like most Spring Boot apps?
      A POM can only have ONE parent, and ours is car-identifier-parent. Importing the
      BOM gets the same version management without taking the parent slot.
      Catch: a BOM manages DEPENDENCY versions only, not plugin versions, which is why
      spring-boot-maven-plugin is pinned in the parent's pluginManagement.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!--
          STARTERS: Spring Boot's "starter" artifacts contain almost no code. Each is a
          curated bundle of dependencies for one job. webmvc = everything for a web app
          with REST controllers: Spring MVC, Jackson (JSON), and an embedded web server.

          EXCLUSIONS: the webmvc starter depends on spring-boot-starter-tomcat, so Tomcat
          arrives transitively. An <exclusion> cuts that one branch out of the
          dependency tree: "bring everything you normally would, EXCEPT this."
          No version is needed in an exclusion: it removes the artifact whatever its version.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-tomcat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          ...and Jetty takes its place. At startup Spring Boot looks at the classpath,
          finds Jetty (and no Tomcat), and starts an embedded Jetty server. Our code
          never mentions Jetty or Tomcat, so swapping servers is a POM-only change.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jetty</artifactId>
        </dependency>

        <!--
          INTER-MODULE DEPENDENCY: the server needs the client's compiled UI files.
          Declaring this does two jobs:
            1. Build order: the reactor now MUST build client before server
               (you'll see it in "Reactor Build Order").
            2. It makes the client's .war available to the unpack step in <build> below.

          type=war: the client's output file is a .war (from gwt-app packaging), not a jar.

          scope=provided: SCOPES control where a dependency is used.
              compile  (default) - compile, test, run, AND packaged into the fat jar
              provided - available while compiling, but NOT packaged ("someone else provides it")
              runtime  - not for compiling, but packaged and used at run time
              test     - only for compiling/running tests (JUnit etc.)
            We don't want the .war itself packed into BOOT-INF/lib/ (it's 13 MB and useless
            there); we only want the files we unpack from it. provided keeps it out.

          The wildcard exclusion: Maven would otherwise also pull in the CLIENT'S
          dependencies (gwt-user, gwt-dev with its Jetty 9.4, SmartGWT) as transitive
          dependencies of the server: the leak problem again, from a different direction.
          groupId=* artifactId=* means "bring in this artifact only, none of its dependencies."
        -->
        <dependency>
            <groupId>io.github.timmyd4</groupId>
            <artifactId>car-identifier-client</artifactId>
            <version>${project.version}</version>
            <type>war</type>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
              Copies the client's compiled UI into the server, so the jar can serve it.

              unpack-dependencies opens the client .war (declared above) and extracts
              only its app/ folder (app.nocache.js, *.cache.js, sc/ ...) into
              target/classes/static/. Result: target/classes/static/app/..., right next
              to index.html, which resources:resources copies from src/main/resources/static/.

              phase=process-resources: run it in the same phase as resource copying, so
              it's done before compile, test and package. The jar:jar goal (package phase)
              then zips target/classes, UI files included.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- An execution id is just a name; it shows in the build output. -->
                        <id>unpack-client-ui</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <!-- Only the client, not every dependency. -->
                            <includeArtifactIds>car-identifier-client</includeArtifactIds>
                            <!-- Only the GWT output folder, not the war's META-INF/ etc. -->
                            <includes>app/**</includes>
                            <!-- ${project.build.outputDirectory} = target/classes -->
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Turns the normal jar into a runnable "fat jar".

              A normal jar only contains OUR classes, so `java -jar` would fail with
              ClassNotFoundException for Spring, Jetty, etc. The repackage goal (bound
              to the package phase) rebuilds the jar with every dependency inside
              (BOOT-INF/lib/) plus a small launcher that knows how to load them.
              Version is pinned in the parent's pluginManagement.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
