{
    // Use the project's virtual environment for running and analyzing Python.
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

    // Don't search inside the dataset, the venv, or generated output (Ctrl+Shift+F).
    "search.exclude": {
        "data/**": true,
        ".venv/**": true,
        "**/checkpoints/**": true,
        "**/runs/**": true,
        "app/target/**": true,
        "app/models/**": true
    },

    // Don't watch these folders for file changes (hundreds of thousands of images would slow VS Code down).
    // runs/ is NOT listed: it holds a few small reports and charts, and watching it
    // makes new output files appear in the Explorer as soon as a script writes them.
    "files.watcherExclude": {
        "**/data/**": true,
        "**/.venv/**": true,
        "**/checkpoints/**": true,
        "**/app/target/**": true,
        "**/app/models/**": true
    },

    // Don't let the Python language server (Pylance) index these folders.
    "python.analysis.exclude": [
        "data",
        ".venv",
        "**/checkpoints",
        "**/runs",
        "app"
    ]
}
